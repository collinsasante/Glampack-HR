# Used by docker-compose.yml on the VPS. Copy to .env and fill in real values —
# this file itself should never contain real secrets (see DEPLOYMENT.md).

DOMAIN=hr.yourdomain.com

POSTGRES_USER=glampack
POSTGRES_PASSWORD=
POSTGRES_DB=glampack_hr

# Full service-account JSON as a single-line string (Firebase Console > Project
# Settings > Service Accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Office geofence center for the Attendance distance-from-office calculation —
# defaults to the old app's hardcoded Glampack office coordinates if left unset.
OFFICE_LATITUDE=5.603717
OFFICE_LONGITUDE=-0.186964

# Same Firebase project as the current site (packaging-glamour-hr) — see
# apps/web/.env.local.example for why these specific values are safe to reuse.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCBOQG9SGC73eAxXPjY7w-qLSw4RQUtKvI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=packaging-glamour-hr.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=packaging-glamour-hr
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=packaging-glamour-hr.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=30061300056
NEXT_PUBLIC_FIREBASE_APP_ID=1:30061300056:web:3274d4a0138ea18745bd2d

# Personal Access Token from https://airtable.com/create/tokens — needs read scope
# (data.records:read) on the Glampack base. Not the same as an MCP/integration
# connection; this script talks to Airtable's REST API directly.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appxBPjMal2Se5ZvI

# Point at a SCRATCH Postgres first and review the printed report before ever pointing
# this at the real production database.
DATABASE_URL=postgresql://user@localhost:5432/glampack_hr_migration_dryrun

# Full service-account JSON as a string (see apps/api/.env.example for the same pattern) —
# used only to backfill firebaseUid by matching email against Firebase Auth's user list.
FIREBASE_SERVICE_ACCOUNT_JSON=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
